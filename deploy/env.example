# Copy to /var/www/itsfreerealestate/.env and edit.
# Never commit the real .env file.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=itsfreerealestate.am,www.itsfreerealestate.am
DJANGO_CSRF_TRUSTED_ORIGINS=https://itsfreerealestate.am,https://www.itsfreerealestate.am

# Use systemd timer for scrapes on the VPS (deploy/itsfreerealestate-scrape.timer)
ENABLE_SCRAPE_SCHEDULER=0
BOT_GATE_ENABLED=1
